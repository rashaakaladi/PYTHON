   "source": [
    "%%writefile circle.py\n",
    "import math\n",
    "\n",
    "def area(r):\n",
    "    return math.pi * r * r\n",
    "\n",
    "def perimeter(r):\n",
    "    return 2 * math.pi * r"
   ]
